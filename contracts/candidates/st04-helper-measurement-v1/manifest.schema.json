{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "v",
    "runtime_authorized",
    "helper_source_sha256",
    "helper_binary_sha256",
    "compiler_binary_sha256",
    "profile_bytes_sha256",
    "controller_source_sha256",
    "build_invocation_sha256",
    "engine_patch_sha256",
    "compiler_version",
    "engine_head",
    "host",
    "root",
    "helper",
    "argv",
    "environment",
    "controller"
  ],
  "properties": {
    "format": {
      "const": "harflow.st04.helper.manifest"
    },
    "v": {
      "const": 1
    },
    "runtime_authorized": {
      "const": false
    },
    "helper_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "helper_binary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compiler_binary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_bytes_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "controller_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_invocation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "engine_patch_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "engine_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "build",
        "architecture",
        "boot_uuid"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "boot_uuid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "device",
        "inode"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "device": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "helper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "device",
        "inode",
        "mode"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "device": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "environment": {
      "const": {}
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "start_seconds",
        "start_microseconds",
        "boot_uuid"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "start_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "start_microseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "boot_uuid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
