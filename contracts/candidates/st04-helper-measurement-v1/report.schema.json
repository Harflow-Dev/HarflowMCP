{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "v",
    "runtime_authorized",
    "production_qualified",
    "rust_adopted",
    "inputs",
    "host",
    "cases",
    "cleanup"
  ],
  "properties": {
    "format": {
      "const": "harflow.st04.helper.measurement"
    },
    "v": {
      "const": 1
    },
    "runtime_authorized": {
      "const": false
    },
    "production_qualified": {
      "const": false
    },
    "rust_adopted": {
      "const": false
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "build",
        "architecture"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation",
          "profile_digest",
          "kind",
          "result",
          "observations",
          "missing",
          "manifest_sha256"
        ],
        "properties": {
          "obligation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "profile_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "static_review",
              "real_process",
              "synthetic_conformance"
            ]
          },
          "result": {
            "enum": [
              "observed_success",
              "failed",
              "unknown",
              "unsupported",
              "not_run"
            ]
          },
          "observations": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "missing": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "cleanup": {
      "enum": [
        "positively_settled",
        "retained_unknown",
        "not_started"
      ]
    }
  }
}
